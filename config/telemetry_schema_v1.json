{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oceansense.local/schemas/telemetry-v1.json",
  "title": "OceanSense canonical telemetry v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "timestamp_s", "mission_id", "duty", "depth_m", "depth_error_m",
    "speed_mps", "vertical_speed_mps", "roll_deg", "pitch_deg", "yaw_rate_dps",
    "current_a", "voltage_v", "thruster_cmd_mean", "thruster_response_ratio",
    "imu_depth_disagreement_m", "dvl_quality", "temperature_c"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "timestamp_s": {"type": "number", "minimum": 0},
    "mission_id": {"type": "string", "minLength": 1},
    "duty": {"enum": ["station_keeping", "pipeline_tracking", "target_waypoint"]},
    "depth_m": {"type": "number", "minimum": 0},
    "depth_error_m": {"type": "number"},
    "speed_mps": {"type": "number", "minimum": 0},
    "vertical_speed_mps": {"type": "number"},
    "roll_deg": {"type": "number", "minimum": -180, "maximum": 180},
    "pitch_deg": {"type": "number", "minimum": -180, "maximum": 180},
    "yaw_rate_dps": {"type": "number"},
    "current_a": {"type": "number", "minimum": 0},
    "voltage_v": {"type": "number", "minimum": 0},
    "thruster_cmd_mean": {"type": "number", "minimum": 0, "maximum": 1},
    "thruster_response_ratio": {"type": "number", "minimum": 0, "maximum": 1.5},
    "imu_depth_disagreement_m": {"type": "number", "minimum": 0},
    "dvl_quality": {"type": "number", "minimum": 0, "maximum": 1},
    "temperature_c": {"type": "number", "minimum": -5, "maximum": 120},
    "field_status": {"type": "object", "additionalProperties": {"enum": ["simulated", "measured", "derived", "unavailable"]}}
  }
}
